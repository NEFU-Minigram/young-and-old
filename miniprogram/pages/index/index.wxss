.chat-container { display: flex; flex-direction: column; height: 100vh; background: #f5f5f5; }
.chat-list { flex: 1; padding: 20rpx; box-sizing: border-box; }
.message { display: flex; margin-bottom: 30rpx; }
.message.user { justify-content: flex-end; }
.message.assistant { justify-content: flex-start; }

/* 用户气泡 */
.message.user text { 
  max-width: 70%; padding: 20rpx; border-radius: 16rpx; font-size: 30rpx; word-break: break-all; 
  background: #07c160; color: #fff; border-top-right-radius: 0; 
}

/* AI 气泡 */
.message.assistant rich-text, .loading-bubble { 
  max-width: 80%; padding: 20rpx; border-radius: 16rpx; font-size: 30rpx; word-break: break-all; 
  background: #fff; color: #333; border-top-left-radius: 0; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05); 
  line-height: 1.6;
}

/* 让 rich-text 里的加粗和代码块好看一点 */
.message.assistant rich-text strong { font-weight: bold; color: #000; }
.message.assistant rich-text code { background: #f0f0f0; padding: 2rpx 8rpx; border-radius: 4rpx; font-family: monospace; }

.loading-bubble { color: #999; font-size: 26rpx; }

/* 底部输入区 */
.input-area { display: flex; padding: 20rpx; background: #fff; border-top: 1rpx solid #eee; }
.input-box { flex: 1; background: #f0f0f0; border-radius: 40rpx; padding: 0 30rpx; height: 80rpx; }
.send-btn { width: 140rpx; height: 80rpx; line-height: 80rpx; margin-left: 20rpx; background: #07c160; color: #fff; border-radius: 40rpx; font-size: 28rpx; }
.send-btn[disabled] { background: #a0e5b8; color: #fff; }