/* ================= 基础容器 ================= */
.page-container {
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  position: relative;
  background: #f5f6f8;
}

/* ================= 视图 1：首页选人界面 ================= */
.home-view {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  height: 100vh;
  box-sizing: border-box;
}

.home-view .title {
  font-size: 46rpx;
  font-weight: bold;
  margin-bottom: 80rpx;
  color: #333;
}

.card {
  width: 100%;
  height: 280rpx;
  border-radius: 30rpx;
  padding: 40rpx;
  box-sizing: border-box;
  margin-bottom: 50rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.08);
  transition: transform 0.2s;
}

.card:active {
  transform: scale(0.98);
}

.old-card { background: linear-gradient(135deg, #a1c4fd 0%, #c2e9fb 100%); }
.young-card { background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%); }

.card-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 20rpx;
}

.card-desc {
  font-size: 30rpx;
  color: #34495e;
}

/* ================= 视图 2：聊天界面 ================= */
.chat-view {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #ededed;
}

/* 顶栏 */
.chat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 30rpx;
  height: 90rpx;
  background: #f7f7f7;
  border-bottom: 1rpx solid #ddd;
  flex-shrink: 0; /* 防止被挤压 */
}

.back-btn {
  font-size: 32rpx;
  color: #333;
  width: 100rpx;
}

.chat-title {
  font-size: 34rpx;
  font-weight: bold;
}

/* 聊天列表 */
.chat-list {
  flex: 1; /* 撑满剩余空间 */
  padding: 30rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

.message {
  display: flex;
  margin-bottom: 40rpx;
}

.message.user { justify-content: flex-end; }
.message.assistant { justify-content: flex-start; }

.message.user text {
  max-width: 70%;
  padding: 24rpx;
  border-radius: 20rpx;
  font-size: 32rpx;
  word-break: break-all;
  background: #95ec69;
  color: #000;
  border-top-right-radius: 4rpx;
}

.message.assistant rich-text, .loading-bubble {
  max-width: 80%;
  padding: 24rpx;
  border-radius: 20rpx;
  font-size: 32rpx;
  word-break: break-all;
  background: #fff;
  color: #333;
  border-top-left-radius: 4rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
  line-height: 1.6;
}

.message.assistant rich-text strong {
  font-weight: bold;
  color: #000;
}

/* 输入区 */
.input-area {
  display: flex;
  padding: 20rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #f7f7f7;
  border-top: 1rpx solid #ddd;
  flex-shrink: 0; /* 防止被键盘顶飞 */
}

.input-box {
  flex: 1;
  background: #fff;
  border-radius: 12rpx;
  padding: 0 20rpx;
  height: 80rpx;
}

.send-btn {
  width: 140rpx;
  height: 80rpx;
  line-height: 80rpx;
  margin-left: 20rpx;
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 0;
}

.send-btn[disabled] {
  background: #a0e5b8;
  color: #fff;
}

/* ================= 三个点加载动画 ================= */
.loading-bubble {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 70rpx;
  padding: 0 30rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  background-color: #999;
  border-radius: 50%;
  margin: 0 6rpx;
  animation: bounce 1.4s infinite ease-in-out both;
}

.dot:nth-child(1) { animation-delay: -0.32s; }
.dot:nth-child(2) { animation-delay: -0.16s; }

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0); }
  40% { transform: scale(1); }
}

/* ================= 转场全屏遮罩 ================= */
.transition-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(255, 255, 255, 0.95);
  z-index: 9999;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #e5e5e5;
  border-top-color: #07c160;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 30rpx;
}

.loading-text {
  font-size: 30rpx;
  color: #666;
  font-weight: bold;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}