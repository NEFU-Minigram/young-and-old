.chat-container { display: flex; flex-direction: column; height: 100vh; background: #ededed; }
.chat-list { flex: 1; padding: 30rpx; box-sizing: border-box; }
.message { display: flex; margin-bottom: 40rpx; }
.message.user { justify-content: flex-end; }
.message.assistant { justify-content: flex-start; }

/* 用户绿气泡 */
.message.user text { 
  max-width: 70%; padding: 24rpx; border-radius: 20rpx; font-size: 32rpx; word-break: break-all; 
  background: #95ec69; color: #000; border-top-right-radius: 4rpx; 
}

/* AI 白气泡 */
.message.assistant rich-text, .loading-bubble { 
  max-width: 80%; padding: 24rpx; border-radius: 20rpx; font-size: 32rpx; word-break: break-all; 
  background: #fff; color: #333; border-top-left-radius: 4rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05); 
  line-height: 1.6;
}
.message.assistant rich-text strong { font-weight: bold; color: #000; }
.message.assistant rich-text div { margin: 10rpx 0; }

/* 底部输入区 */
.input-area { display: flex; padding: 20rpx; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); background: #f7f7f7; border-top: 1rpx solid #ddd; }
.input-box { flex: 1; background: #fff; border-radius: 12rpx; padding: 0 20rpx; height: 80rpx; }
.send-btn { width: 140rpx; height: 80rpx; line-height: 80rpx; margin-left: 20rpx; background: #07c160; color: #fff; border-radius: 12rpx; font-size: 30rpx; padding: 0; }
.send-btn[disabled] { background: #a0e5b8; color: #fff; }