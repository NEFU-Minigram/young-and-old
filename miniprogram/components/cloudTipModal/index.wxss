.home-container { display: flex; flex-direction: column; align-items: center; padding: 80rpx 40rpx; background: #f5f6f8; height: 100vh; box-sizing: border-box; }
.title { font-size: 46rpx; font-weight: bold; margin-bottom: 80rpx; color: #333; }
.card { width: 100%; height: 280rpx; border-radius: 30rpx; padding: 40rpx; box-sizing: border-box; margin-bottom: 50rpx; display: flex; flex-direction: column; justify-content: center; box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.08); transition: transform 0.2s; }
.card:active { transform: scale(0.98); }
.old-card { background: linear-gradient(135deg, #a1c4fd 0%, #c2e9fb 100%); }
.young-card { background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%); }
.card-title { font-size: 44rpx; font-weight: bold; color: #2c3e50; margin-bottom: 20rpx; }
.card-desc { font-size: 30rpx; color: #34495e; }